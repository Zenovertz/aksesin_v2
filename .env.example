# Salin menjadi .env di akar proyek, lalu restart npm start.
# Jangan commit .env. Panduan peta: docs/cesium.md.

# SERVER — hanya menerima koneksi lokal.
HOST=127.0.0.1
PORT=3000

# OPENAI — opsional; key rahasia, hanya dibaca server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# CESIUM — peta dasar tetap aktif tanpa token.
# Token ini PUBLIK dan dikirim ke browser melalui /api/config/maps.
# Gunakan token ion assets:read, batasi allowed URLs dan aset.
# Jangan gunakan token dengan izin menulis/admin atau key rahasia lain.
CESIUM_ION_ACCESS_TOKEN=
# true mengaktifkan Cesium World Terrain + OSM Buildings jika token diisi.
CESIUM_ENABLE_3D=false
